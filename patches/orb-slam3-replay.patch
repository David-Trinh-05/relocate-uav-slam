+namespace {
+void TraceReplayEvent(const char* event, const Frame& frame, Map* map,
+                      KeyFrame* keyframe = nullptr, int count = 0)
+{
+    static const bool enabled = std::getenv("RELOCATE_TRACE_REPLAY") != nullptr;
+    if (!enabled)
+        return;
+    static std::ofstream trace("events.csv");
+    if (!trace)
+        throw std::runtime_error("Cannot write events.csv");
+    static bool first = true;
+    if (first)
+    {
+        trace << "event,timestamp_ns,map_id,keyframe_id,count,x,y,z\n";
+        first = false;
+    }
+    trace << event << ',' << std::llround(frame.mTimeStamp * 1e9) << ',' << map->GetId() << ',';
+    if (keyframe)
+    {
+        const auto center = keyframe->GetCameraCenter();
+        trace << keyframe->mnId << ',' << count << ',' << center.x() << ',' << center.y() << ',' << center.z();
+    }
+    else
+        trace << ',' << count << ",,,";
+    trace << '\n';
+}
+}
 
